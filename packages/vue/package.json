{
  "name": "@ldesign/flowchart-vue",
  "version": "1.0.0",
  "description": "Vue components for flowchart designer",
  "keywords": [
    "flowchart",
    "workflow",
    "vue",
    "vue3",
    "vue-component",
    "approval"
  ],
  "author": "LDesign Team",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./es/index.d.ts",
      "import": "./es/index.js",
      "require": "./lib/index.cjs"
    },
    "./composables/*": {
      "types": "./es/composables/*.d.ts",
      "import": "./es/composables/*.js",
      "require": "./lib/composables/*.cjs"
    },
    "./es/index.css": "./es/index.css",
    "./lib/index.css": "./lib/index.css",
    "./dist/index.css": "./dist/index.css",
    "./dist/index.min.css": "./dist/index.min.css"
  },
  "main": "./lib/index.cjs",
  "module": "./es/index.js",
  "types": "./es/index.d.ts",
  "unpkg": "./dist/index.min.js",
  "jsdelivr": "./dist/index.min.js",
  "files": [
    "README.md",
    "LICENSE",
    "package.json",
    "es",
    "lib",
    "dist"
  ],
  "scripts": {
    "dev": "ldesign-builder watch",
    "build": "ldesign-builder build",
    "test": "vitest",
    "demo": "cd demo && pnpm dev",
    "type-check": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@ldesign/flowchart-core": "workspace:*",
    "@vueuse/core": "^10.7.0"
  },
  "peerDependencies": {
    "vue": "^3.3.0"
  },
  "devDependencies": {
    "@ldesign/builder": "workspace:*",
    "@types/node": "^20.10.0",
    "@vitejs/plugin-vue": "^4.5.0",
    "@vue/compiler-sfc": "^3.3.0",
    "typescript": "^5.3.3",
    "vitest": "^1.0.0",
    "vue-tsc": "^1.8.0"
  }
}